<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@drawable/ic_plane"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OmniClaim AI"
        android:textColor="@color/text_white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Autonomous Passenger Advocate"
        android:textColor="@color/sky_400"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="36dp" />

    <ProgressBar
        android:id="@+id/pbSplashProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="220dp"
        android:layout_height="8dp"
        android:progressDrawable="@drawable/splash_progress"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/tvSplashStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Initializing Neural Engine &amp; METAR Logs..."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="14dp" />

</LinearLayout>
