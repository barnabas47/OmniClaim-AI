<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Upload Card (Clickable Native Camera/Gallery Scanner) -->
        <LinearLayout
            android:id="@+id/cardUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg_modern"
            android:padding="24dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_scan"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to Scan Boarding Pass or Receipt"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUploadSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opens Phone Camera / Gallery for Vision AI OCR"
                android:textColor="@color/sky_400"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Flight Scenario Pills -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLIGHT SCENARIOS"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScenarioLH401"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="LH401 (Frankfurt)"
                android:textAllCaps="false"
                android:textColor="@color/amber_400"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/card_bg"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnScenarioFR8821"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="FR8821 (London)"
                android:textAllCaps="false"
                android:textColor="@color/sky_400"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/card_bg"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Document OCR Editor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOCUMENT TEXT CONTENT"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etOcrText"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:gravity="top|start"
            android:background="@drawable/input_bg_modern"
            android:textColor="@color/sky_400"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:padding="16dp" />

        <!-- Parse Button with Loading Spinner -->
        <Button
            android:id="@+id/btnParseClaim"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Parse &amp; Generate Claim"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/button_gradient"
            android:backgroundTint="@null"
            android:layout_marginTop="24dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvStatusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/emerald_400"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
