<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <!-- Top Metric Highlight Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- Delay Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg_modern"
                android:padding="18dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FLIGHT DELAY"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvDelayDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4h 15m"
                    android:textColor="@color/amber_400"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Total Claim Value Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg_modern"
                android:padding="18dp"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL CLAIM"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvTotalClaimValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="€665.00"
                    android:textColor="@color/emerald_400"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Weather Disproval Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg_modern"
            android:padding="18dp"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_weather"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="METAR WEATHER BLUFF DISPROVED"
                    android:textColor="@color/sky_400"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMetarSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Official METAR weather at Frankfurt Airport confirmed VFR conditions (Visibility 10000m). 93.8% of parallel flights departed normally."
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Form Inputs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDITABLE CLAIM DETAILS"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg_modern"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Claim ID"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <EditText
                android:id="@+id/etClaimId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="CLM-2026-LH401-992"
                android:textColor="@color/sky_400"
                android:textSize="13sp"
                android:background="@drawable/input_bg_modern"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carrier Name"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <EditText
                android:id="@+id/etCarrier"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Lufthansa German Airlines"
                android:textColor="@color/sky_400"
                android:textSize="13sp"
                android:background="@drawable/input_bg_modern"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flight Number"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                    <EditText
                        android:id="@+id/etFlightNumber"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="LH401"
                        android:textColor="@color/sky_400"
                        android:textSize="13sp"
                        android:background="@drawable/input_bg_modern"
                        android:paddingHorizontal="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Booking PNR"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                    <EditText
                        android:id="@+id/etPnrCode"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="PNR-LH992"
                        android:textColor="@color/sky_400"
                        android:textSize="13sp"
                        android:background="@drawable/input_bg_modern"
                        android:paddingHorizontal="14dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passenger Full Name"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <EditText
                android:id="@+id/etPassengerName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Alex Morgan"
                android:textColor="@color/sky_400"
                android:textSize="13sp"
                android:background="@drawable/input_bg_modern"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passenger Email"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <EditText
                android:id="@+id/etPassengerEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="alex.morgan@example.com"
                android:textColor="@color/sky_400"
                android:textSize="13sp"
                android:background="@drawable/input_bg_modern"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regulation Basis"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <EditText
                android:id="@+id/etRegulationBasis"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="EU261/2004 Article 7 Statutory Entitlement"
                android:textColor="@color/sky_400"
                android:textSize="13sp"
                android:background="@drawable/input_bg_modern"
                android:paddingHorizontal="14dp" />

        </LinearLayout>

        <!-- Dynamic AI Translation Bar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DYNAMIC AI TRANSLATION INTEGRATION"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/etTargetLang"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Target language (e.g. German, Hungarian, Spanish)"
                android:text="German"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="12sp"
                android:background="@drawable/input_bg_modern"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnTranslateNotice"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Translate AI"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="@color/sky_500" />
        </LinearLayout>

        <!-- Fully Scrollable Demand Notice -->
        <EditText
            android:id="@+id/etLegalLetter"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="top|start"
            android:background="@drawable/input_bg_modern"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:nestedScrollingEnabled="true"
            android:padding="14dp" />

        <!-- Responsive Action Buttons Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp">

            <Button
                android:id="@+id/btnOpenGmail"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Open Gmail"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_gmail"
                android:drawablePadding="6dp"
                android:paddingStart="12dp"
                android:backgroundTint="@color/rose_400"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnApproveClaim"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Approve"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/emerald_400"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
